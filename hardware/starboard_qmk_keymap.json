  "rotary_encoders": [
    {
      "id": 0,
      "label": "Time Scrubbing Encoder",
      "clockwise": {
        "action": "SCRUB_FORWARD",
        "description": "Step 1 bar forward in historical time series (Right Arrow)"
      },
      "counter_clockwise": {
        "action": "SCRUB_BACKWARD",
        "description": "Step 1 bar backward in historical time series (Left Arrow)"
      },
      "switch_press": {
        "action": "SNAP_T0",
        "description": "Snap chart view to latest conflated market tick (T_0)"
      }
    },
    {
      "id": 1,
      "label": "Resolution & Zoom Encoder",
      "clockwise": {
        "action": "ZOOM_IN",
        "description": "Increase chart resolution / switch to lower timeframe (1D -> 4H -> 1H)"
      },
      "counter_clockwise": {
        "action": "ZOOM_OUT",
        "description": "Decrease chart resolution / switch to higher timeframe (1H -> 4H -> 1D)"
      },
      "switch_press": {
        "action": "FIT_CONTENT",
        "description": "Auto-fit chart visible range to canvas dimensions"
      }
    }
  ],
